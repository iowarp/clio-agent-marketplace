[
  {
    "id": "first_contact_onboarding",
    "bundle": "primary",
    "preconditions": "no experiment card for this export in the workspace store",
    "user_message": "Here is an APPL-CORE export: {bundle_root}. Onboard it and tell me what I should be careful about before analysing it.",
    "expect": {
      "response": {
        "nonempty": true,
        "min_words": 60,
        "max_words": 400
      },
      "actions": {
        "required_skills": [
          "appl-core-exports",
          "onboard-dataset",
          "evidence-and-claims"
        ],
        "required_scripts": [
          "inventory.py",
          "audit_columns.py",
          "flag_check.py",
          "join_keys.py",
          "card.py"
        ]
      },
      "card": {
        "exists": true,
        "min_tagged_claims": 10,
        "min_open_questions": 2,
        "required_trap_classes": [
          "sentinel-values",
          "ghost-columns",
          "near-duplicate-columns",
          "unflagged-missing",
          "universal-flag",
          "key-format-mismatch",
          "unit-scale-suspect",
          "saturation-clipping",
          "duplicate-measures",
          "declared-vs-actual",
          "irregular-sampling"
        ]
      },
      "loader": {
        "deterministic": true,
        "verified": true
      }
    }
  },
  {
    "id": "first_contact_delegated",
    "bundle": "primary",
    "preconditions": "no experiment card for this export in the workspace store",
    "user_message": "Audit {bundle_root} in the background and give me the short version when it is done.",
    "expect": {
      "response": {
        "nonempty": true,
        "min_words": 40,
        "max_words": 300
      },
      "actions": {
        "required": [
          "spawn_skill_task",
          "wait_agent_tasks"
        ],
        "required_skills": [
          "audit-dataset"
        ]
      },
      "outcome": {
        "children_completed": true
      },
      "card": {
        "exists": true,
        "min_tagged_claims": 10
      },
      "loader": {
        "parent_reran_after_child": true,
        "verified": true
      }
    }
  },
  {
    "id": "card_reuse_second_session",
    "bundle": "primary",
    "preconditions": "a current card, loader, and views from first_contact_onboarding in the same workspace store; fresh session",
    "user_message": "Using the export at {bundle_root}, how many plants per treatment level are there?",
    "expect": {
      "response": {
        "nonempty": true,
        "min_words": 15,
        "max_words": 200
      },
      "actions": {
        "required_scripts": [
          "card.py"
        ]
      },
      "outcome": {
        "no_reprofile": true
      },
      "loader": {
        "verified": true
      }
    }
  },
  {
