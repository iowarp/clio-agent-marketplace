{
  "format": "clio.dashboard.document.v1",
  "title": "Training: hybrid model and baseline",
  "notes": "Replace <view_uri> (twice) with the view_uri open_stream returned. Records carry epoch, model, loss and train_acc.",
  "components": [
    {"id": "root", "component": "Column", "children": ["scope", "curves"]},
    {"id": "scope", "component": "Text", "text": "<the task, the models and the data, in one line>"},
    {"id": "curves", "component": "Row", "align": "stretch", "children": ["lossFrame", "accFrame"]},
    {"id": "lossFrame", "component": "Frame", "title": "Loss per epoch", "child": "loss"},
    {
      "id": "loss",
      "component": "clio.chart.v1",
      "preset": "trajectories",
      "dataUri": "<view_uri>",
      "xField": "epoch",
      "yField": "loss",
      "entityField": "model",
      "xType": "quantitative",
      "height": 280
    },
    {"id": "accFrame", "component": "Frame", "title": "Training accuracy per epoch", "child": "acc"},
    {
      "id": "acc",
      "component": "clio.chart.v1",
      "preset": "trajectories",
      "dataUri": "<view_uri>",
      "xField": "epoch",
      "yField": "train_acc",
      "entityField": "model",
      "xType": "quantitative",
      "height": 280
    }
  ]
}
