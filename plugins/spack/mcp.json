{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "spack": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "spack-mcp @ git+https://github.com/iowarp/clio-kit@d1eff1a194253b52181611c2acc42d6daa3fa37d#subdirectory=mcp-servers/spack",
        "spack-mcp"
      ],
      "env": {
        "SPACK_MCP_PROFILE": "user"
      }
    }
  }
}
