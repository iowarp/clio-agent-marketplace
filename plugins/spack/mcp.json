{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "spack": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "spack-mcp @ git+https://github.com/iowarp/clio-kit@ef42fcf3dd57eca03602d04d2ac363d441f40b58#subdirectory=mcp-servers/spack",
        "spack-mcp"
      ],
      "env": {
        "SPACK_MCP_PROFILE": "user"
      }
    }
  }
}
