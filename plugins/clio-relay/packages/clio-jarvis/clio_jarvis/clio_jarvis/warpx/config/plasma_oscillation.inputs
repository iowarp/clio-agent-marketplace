# A cold, uniform electron plasma, periodic in a 40 um cube, given a small
# sinusoidal velocity along z: a Langmuir wave. Ez rings at the plasma
# frequency, omega_p = 8e13 rad/s at 2e24 m^-3, a period of about 36 steps.
# Written for clio-jarvis's warpx self-test; the package sets max_step and
# adds its own plotfile diagnostic.

max_step = 40
geometry.dims = 3
geometry.prob_lo = -20.e-6 -20.e-6 -20.e-6
geometry.prob_hi =  20.e-6  20.e-6  20.e-6
amr.n_cell = 32 32 32
amr.max_grid_size = 16
amr.blocking_factor = 8
amr.max_level = 0

boundary.field_lo = periodic periodic periodic
boundary.field_hi = periodic periodic periodic

algo.maxwell_solver = yee
algo.current_deposition = esirkepov
algo.particle_shape = 1
warpx.cfl = 0.9

particles.species_names = electrons
electrons.charge = -q_e
electrons.mass = m_e
electrons.injection_style = "NUniformPerCell"
electrons.num_particles_per_cell_each_dim = 1 1 2
electrons.profile = constant
electrons.density = 2.e24
electrons.momentum_distribution_type = parse_momentum_function
electrons.momentum_function_ux(x,y,z) = "0."
electrons.momentum_function_uy(x,y,z) = "0."
electrons.momentum_function_uz(x,y,z) = "0.01*sin(157079.63267948966*z)"