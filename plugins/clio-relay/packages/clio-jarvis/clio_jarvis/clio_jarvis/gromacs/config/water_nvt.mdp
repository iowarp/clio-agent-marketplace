; NVT molecular dynamics of SPC/E water at 300 K, velocities drawn at the start.
integrator     = md
dt             = 0.002
nsteps         = 5000
cutoff-scheme  = Verlet
coulombtype    = PME
rcoulomb       = 1.0
rvdw           = 1.0
pbc            = xyz
constraints    = h-bonds
tcoupl         = V-rescale
tc-grps        = System
tau-t          = 0.1
ref-t          = 300
gen-vel        = yes
gen-temp       = 300
gen-seed       = 4928459
nstenergy      = 500
nstlog         = 500
