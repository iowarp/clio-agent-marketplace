# A Lennard-Jones crystal melting: 16384 atoms on an fcc lattice at reduced
# density 0.8442 start with velocities for T* = 3, well above melting, so
# the order of the lattice is lost within a few hundred steps.
units           lj
atom_style      atomic

lattice         fcc 0.8442
region          box block 0 16 0 16 0 16
create_box      1 box
create_atoms    1 box
mass            1 1.0

velocity        all create 3.0 4928459 loop geom

pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5

neighbor        0.3 bin
neigh_modify    every 20 delay 0 check no

fix             1 all nve

thermo          100
run             2000
