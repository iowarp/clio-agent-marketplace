{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "h5": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${PLUGIN_ROOT}/impl",
        "hdf5-ptc-mcp"
      ],
      "env": {
        "CLIO_SOURCE_RANGE_ORIGIN": "${CLIO_SOURCE_RANGE_ORIGIN}"
      }
    }
  }
}
