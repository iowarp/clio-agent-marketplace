{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {"name": "source"},
  "vconcat": [
    {
      "title": "Games by branch",
      "transform": [
        {"filter": "datum.pos == 0 && datum.turn == 1"},
        {"calculate": "datum.status == 'solved' ? datum.turns : null", "as": "solved_turns"},
        {"calculate": "datum.status == 'failed' ? 1 : 0", "as": "failed"}
      ],
      "mark": {"type": "bar"},
      "encoding": {
        "y": {"field": "branch", "type": "nominal", "title": null},
        "x": {"aggregate": "count", "type": "quantitative", "title": "games played"},
        "color": {"field": "branch", "type": "nominal", "legend": null},
        "tooltip": [
          {"field": "branch", "type": "nominal"},
          {"aggregate": "count", "type": "quantitative", "title": "games"},
          {"field": "solved_turns", "aggregate": "mean", "type": "quantitative", "title": "mean guesses (solved)", "format": ".2f"},
          {"field": "failed", "aggregate": "sum", "type": "quantitative", "title": "failures"}
        ]
      }
    },
    {
      "facet": {"field": "board", "type": "nominal", "title": null, "sort": {"field": "branch"}},
      "columns": 10,
      "spec": {
        "width": 70,
        "height": 84,
        "layer": [
          {
            "mark": {"type": "rect", "strokeWidth": 2},
            "encoding": {
              "x": {"field": "pos", "type": "ordinal", "axis": null},
              "y": {"field": "turn", "type": "ordinal", "axis": null, "scale": {"domain": [1, 2, 3, 4, 5, 6]}},
              "fill": {
                "field": "state",
                "type": "nominal",
                "scale": {"domain": ["correct", "present", "absent"], "range": ["#2f9e44", "#e0b000", "#868e96"]},
                "legend": {"orient": "bottom", "title": "letter"}
              },
              "stroke": {"field": "branch", "type": "nominal", "legend": null},
              "tooltip": [
                {"field": "branch", "type": "nominal"},
                {"field": "game", "type": "nominal"},
                {"field": "word", "type": "nominal", "title": "guess"},
                {"field": "status", "type": "nominal"}
              ]
            }
          },
          {
            "mark": {"type": "text", "color": "white", "fontWeight": "bold"},
            "encoding": {
              "x": {"field": "pos", "type": "ordinal"},
              "y": {"field": "turn", "type": "ordinal"},
              "text": {"field": "letter", "type": "nominal"}
            }
          }
        ]
      }
    }
  ]
}
